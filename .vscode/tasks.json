{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tarteel House: local QA server",
      "type": "shell",
      "command": "make dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Tarteel House: standard checks",
      "type": "shell",
      "command": "make check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Tarteel House: browser checks",
      "type": "shell",
      "command": "make check-browser",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
